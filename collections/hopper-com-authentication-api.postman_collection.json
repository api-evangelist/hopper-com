    {
      "id": "166010d8-52ee-4da1-b265-0a67d4b7bb39",
      "name": "Authentication",
      "description": {
        "content": "This API is authenticated with OAuth 2, Client Credentials grant.\\\nClients should use their `client_id` and `client_secret` to obtain an `access_token`.\\\nThe `access_token` should be included in every request, as a `Bearer` token on an `Authorization` header.\\\nNote that `access_token`s eventually expire, requiring a new token to be fetched.\n\nsee [authentication](#tag/Authentication)",
        "type": "text/plain"
      },
